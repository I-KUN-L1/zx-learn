# ==========================================================
# 知行智学 ZhiXing Learn - 环境变量模板
# 用法：复制本文件为 .env 并填写真实值
#   Linux/macOS : cp .env.example .env
#   Windows      : copy .env.example .env
# 各服务 src/main/resources/application.yml 通过 ${VAR} 自动读取
# 注意：请勿将填写后的 .env 提交到版本库
# ==========================================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password
# docker-compose 初始化容器时使用的 root 密码
MYSQL_ROOT_PASSWORD=your-mysql-root-password
# docker-compose 中 MySQL 容器映射到宿主机的端口（宿主机 3306 已装 MySQL 时改为 13306 等空闲端口即可避让）
#MYSQL_BIND_PORT=3306

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ---------- RocketMQ（交易最终一致性 / 后续秒杀） ----------
# NameServer 地址；各服务 application.yml 默认 localhost:9876，容器化部署时改为服务名
ROCKETMQ_NAME_SERVER=localhost:9876

# ---------- PostgreSQL / pgvector（RAG 向量知识库，aigc-service 使用） ----------
POSTGRES_URL=jdbc:postgresql://localhost:5432/zx_aigc
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your-postgres-password

# ---------- 支付（zx-trade + zx-pay，两服务共用同一密钥） ----------
# 支付回调验签密钥（HMAC-SHA256；生产由支付渠道下发，本地联调用 Mock 签名）。必填。
#   · zx-trade（pay.callback-secret）：订单支付回调链路，缺失时**启动即失败**（fail-fast）；
#   · zx-pay（pay.notify.secret）    ：/notify/alipay|wxpay 渠道回调，缺失时回调一律**拒绝**（fail-closed 501）。
# 生成示例：openssl rand -hex 32
PAY_CALLBACK_SECRET=your-pay-callback-secret

# ---------- JWT ----------
# HS256 签名密钥，长度必须 >= 32 字节，务必替换为随机强密钥
# 生成示例：openssl rand -base64 48
ZX_JWT_SECRET=your-strong-jwt-secret-at-least-32-bytes

# ---------- 用户 ----------
# 管理员重置用户密码时的统一初始密码（重置后固定为 123456）
ZX_USER_DEFAULT_PASSWORD=123456

# ---------- 首个管理员引导（zx-auth，可选） ----------
# 首次启动 zx-auth 时，若数据库中不存在管理员账号，会使用系统预设默认密码创建管理员
# （默认 123456，与默认学员/教师种子账号一致，均为纯数字）、BCrypt 加密入库，
# 并将凭据写入应用根目录 .bootstrap-credentials（该文件已被 git 忽略，
# 首次登录后请调 POST /accounts/password/first-change 修改密码，成功后会自动删除）。
# 以下变量均可留空使用默认值，仅需定制时设置：
# 预设初始密码（纯数字，建议首次登录后立即修改）
#ADMIN_INIT_PASSWORD=123456
# 初始凭据落盘路径（可绝对路径或相对应用根目录）
#ZX_ADMIN_CREDENTIAL_FILE=.bootstrap-credentials
# 首个管理员手机号
#ZX_ADMIN_PHONE=13800000000
# 首个管理员用户名
#ZX_ADMIN_USERNAME=admin

# ---------- 阿里云 OSS 图片存储（zx-media，可选） ----------
# 未配置时自动降级为本地磁盘存储（MEDIA_LOCAL_DIR 目录），上传图片经媒体服务回源访问；
# 配置齐备后图片直传 OSS，访问经 OSS/CDN 域名 302 重定向。
# 存储模式：auto（默认，配齐 OSS 即用 OSS）/ oss（强制，缺失配置启动失败）/ local（强制本地）
#MEDIA_STORAGE_MODE=auto
# 本地存储目录（本地兜底模式使用）
#MEDIA_LOCAL_DIR=./data/media
#OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#OSS_ACCESS_KEY_ID=your-oss-access-key-id
#OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
#OSS_BUCKET=your-bucket-name
# 自定义 CDN 加速域名（可选，为空用 bucket.endpoint 默认域名）
#OSS_URL_PREFIX=

# ---------- AI / LLM（可选） ----------
# 未配置 api-key 时，AI 助教与学情分析自动降级为模拟/规则结果
ZX_LLM_BASE_URL=https://api.openai.com
ZX_LLM_API_KEY=
ZX_LLM_MODEL=gpt-3.5-turbo
ZX_LLM_ENABLED=false
# 对话补全接口路径与采样参数（留空走服务默认值：/v1/chat/completions、temperature 0.7、top_p 1.0、max_tokens 1024）
#ZX_LLM_CHAT_PATH=/v1/chat/completions
#ZX_LLM_TEMPERATURE=0.7
#ZX_LLM_TOP_P=1.0
#ZX_LLM_MAX_TOKENS=1024
# ---------- RAG 向量化（Embedding）----------
# 这三个变量必须**互相配套**，配错不会报错、只会静默降级为伪向量（检索结果失去语义）：
#   ① ZX_LLM_EMBEDDING_PATH：相对 ZX_LLM_BASE_URL 的向量化路径，不要写死
#        · base-url 已含版本段（智谱 https://open.bigmodel.cn/api/paas/v4）→ embeddings
#        · base-url 不含版本段（OpenAI https://api.openai.com）           → v1/embeddings
#      配错的典型症状：拼出 /v4/v1/embeddings → HTTP 404 → 每次都走降级分支
#   ② ZX_LLM_EMBEDDING_MODEL：必须是**该 base-url 所属厂商真实存在**的模型编码
#        · 智谱 → embedding-3；OpenAI → text-embedding-3-small
#      用 OpenAI 的模型名去请求智谱会返回「1211 模型不存在」
#   ③ ZX_LLM_EMBEDDING_DIMENSION：必须**等于** pgvector 列 knowledge_chunk.embedding 的维度，
#      否则写入会被 PostgreSQL 拒绝（维度不符）。
#        · 智谱 embedding-3 可选 256/512/1024/2048（**不含 1536**）
#        · pgvector 的 HNSW 索引对 vector 类型上限 2000 维 ⇒ 2048 无法建索引
#      两者取交集，本项目统一使用 1024（详见 deploy/pgvector/init.sql 与 migrate-embedding-dim.sql）
ZX_LLM_EMBEDDING_PATH=embeddings
ZX_LLM_EMBEDDING_MODEL=embedding-3
ZX_LLM_EMBEDDING_DIMENSION=1024

# ==========================================================
# 以下为「部署形态」相关变量：本地开发可全部留空（走各服务 application.yml 的默认值），
# 容器化 / 生产部署时必须按实际情况覆盖。
# ==========================================================

# ---------- 镜像版本标签（docker-compose.prod.yml 用） ----------
# 构建出的镜像 tag：zx-learn/<模块>:${ZX_VERSION:-latest}。发布时建议用版本号或 git sha，便于回滚。
#ZX_VERSION=latest

# ---------- 注册中心 Nacos ----------
# 关闭时（默认）各服务走 application.yml 里的静态实例直连（spring.cloud.discovery.client.simple.instances），
# 适用于单机/开发；**多实例、滚动发布、容器化部署必须置 true 并把 NACOS_ADDR 指向注册中心**，
# 否则服务间 Feign 调用会因为静态地址写死而无法负载均衡/发现新实例。
#NACOS_ENABLED=false
#NACOS_ADDR=localhost:8848
# 配置中心（当前项目未使用 Nacos 配置中心，保持 false 即可）
#NACOS_CONFIG_ENABLED=false

# ---------- 网关 CORS（浏览器直连网关的前端来源） ----------
# 生产填实际前端域名（逗号分隔多个）；同源部署（Nginx 反代同域）时无需跨域，保持默认即可。
# 切勿填 *：本项与 allow-credentials=true 组合时浏览器会直接拒绝。
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 网关下游路由地址（仅在不启用 Nacos 时生效） ----------
# 默认全部指向 localhost:<port>，适用于本机运行。
# 容器化部署时改成容器服务名，例如 GW_AUTH_URI=http://zx-auth:8081
# 启用 Nacos 后应将 uri 改为 lb://<服务名>（见 docs/DEPLOYMENT.md 第 4 节）。
#GW_AUTH_URI=http://localhost:8081
#GW_USER_URI=http://localhost:8082
#GW_COURSE_URI=http://localhost:8083
#GW_EXAM_URI=http://localhost:8084
#GW_MEDIA_URI=http://localhost:8085
#GW_LEARNING_URI=http://localhost:8086
#GW_TRADE_URI=http://localhost:8087
#GW_PROMOTION_URI=http://localhost:8088
#GW_AIGC_URI=http://localhost:8089
#GW_PAY_URI=http://localhost:8090
#GW_SEARCH_URI=http://localhost:8091
#GW_REMARK_URI=http://localhost:8092
#GW_MESSAGE_URI=http://localhost:8093
#GW_DATA_URI=http://localhost:8094
#GW_INSIGHT_URI=http://localhost:8095

# ---------- 服务间调用地址（不启用 Nacos 时的静态实例，仅容器化/多机部署需要覆盖） ----------
# 各业务服务通过 spring.cloud.discovery.client.simple.instances 做静态服务发现，
# 默认值全部是 http://localhost:<port>（本机开发直接可用）。
# **容器内 localhost 指容器自身**，因此容器化部署必须在这里改成容器服务名，
# 否则跨服务 Feign 调用会打到自己身上（表现为券状态不同步、订单缺用户信息等静默故障）。
# 单机 docker compose 部署无需手工填 —— docker-compose.prod.yml 的 x-app-env 已统一注入。
# 手工部署 / 多机部署时按需填写（启用 Nacos 后本段可忽略）：
#SVC_AUTH_URI=http://zx-auth:8081
#SVC_USER_URI=http://zx-user:8082
#SVC_COURSE_URI=http://zx-course:8083
#SVC_EXAM_URI=http://zx-exam:8084
#SVC_MEDIA_URI=http://zx-media:8085
#SVC_LEARNING_URI=http://zx-learning:8086
#SVC_TRADE_URI=http://zx-trade:8087
#SVC_PROMOTION_URI=http://zx-promotion:8088
#SVC_AIGC_URI=http://zx-aigc:8089
#SVC_PAY_URI=http://zx-pay:8090
#SVC_SEARCH_URI=http://zx-search:8091
#SVC_REMARK_URI=http://zx-remark:8092
#SVC_MESSAGE_URI=http://zx-message:8093
#SVC_DATA_URI=http://zx-data:8094
#SVC_INSIGHT_URI=http://zx-insight:8095

# ---------- 交易链路死信告警（zx-trade） ----------
# 死信重放开关（默认 true）：每 30 分钟把超重试上限的本地消息退回待投递再投一次
#TX_DEAD_REPLAY_ENABLED=true
# 死信告警外发地址（企业微信/钉钉机器人/自建告警网关）。
# 留空则只写日志并暴露指标 zx.trade.order.msg.dead（生产建议接入，做到"死信产生即可见"）
#TX_DEAD_ALERT_WEBHOOK=
