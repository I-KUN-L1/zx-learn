<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Scenario3-AigcChat" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">localhost</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">8089</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PROTOCOL" elementType="Argument"><stringProp name="Argument.name">PROTOCOL</stringProp><stringProp name="Argument.value">http</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="THREADS" elementType="Argument"><stringProp name="Argument.name">THREADS</stringProp><stringProp name="Argument.value">50</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="LOOPS" elementType="Argument"><stringProp name="Argument.name">LOOPS</stringProp><stringProp name="Argument.value">100</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="QUESTION" elementType="Argument"><stringProp name="Argument.name">QUESTION</stringProp><stringProp name="Argument.value">什么是微服务架构？请结合课程资料回答。</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Warmup-Threads" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(WARMUP_LOOPS,2)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="WARMUP SSE 对话（JIT/连接池热身）" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[import java.io.*
import java.net.*
import java.util.UUID

// 注意：不要 import SampleResult 类，否则隐式绑定变量会被类名遮蔽（Groovy 走 static 解析报错）

String host  = props.get("HOST") as String ?: "localhost"
int    port  = Integer.parseInt(props.get("PORT") as String ?: "8089")
String proto = props.get("PROTOCOL") as String ?: "http"
String sessionId = "warmup-" + UUID.randomUUID().toString()

if (System.getProperty("http.maxConnections") == null) {
    System.setProperty("http.keepAlive", "true")
    System.setProperty("http.maxConnections", "2000")
}

SampleResult.sampleStart()
URL u = new URL(proto + "://" + host + ":" + port + "/chat")
HttpURLConnection conn = (HttpURLConnection) u.openConnection()
conn.setRequestMethod("POST")
conn.setConnectTimeout(5000)
conn.setReadTimeout(15000)
conn.setDoOutput(true)
conn.setDoInput(true)
conn.setRequestProperty("Content-Type", "application/json;charset=UTF-8")
conn.setRequestProperty("Accept", "text/event-stream")
conn.setRequestProperty("user-info", "1")
BufferedOutputStream out = new BufferedOutputStream(conn.getOutputStream())
out.write(('{"sessionId":"' + sessionId + '","question":"你好"}').getBytes("UTF-8")); out.flush(); out.close()
int code = conn.getResponseCode()
InputStream is = (code >= 200 && code < 300) ? conn.getInputStream() : conn.getErrorStream()
BufferedReader br = new BufferedReader(new InputStreamReader(is, "UTF-8"))
String line
try { while ((line = br.readLine()) != null) { if (line.indexOf('"type":"END"') >= 0) break } } finally {
    try { br.close() } catch (IOException ignore) {}
    try { is.close() } catch (IOException ignore) {}
}
SampleResult.sampleEnd()
SampleResult.setResponseCode(String.valueOf(code))
SampleResult.setSuccessful(code >= 200 && code < 300)
SampleResult.setResponseData("warmup done".getBytes("UTF-8"))]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="interpreterClass"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="AigcChat-Threads" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(LOOPS,100)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(THREADS,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">10</stringProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SSE AI 对话（读流至 END）" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script"><![CDATA[import java.io.*
import java.net.*
import java.util.UUID

String host  = props.get("HOST") as String ?: "localhost"
int    port  = Integer.parseInt(props.get("PORT") as String ?: "8089")
String proto = props.get("PROTOCOL") as String ?: "http"
String question = props.get("QUESTION") as String ?: "什么是微服务架构？请结合课程资料回答。"
int    userNum  = (ctx != null) ? ctx.getThreadNum() + 1 : 1
String sessionId = "sse-" + UUID.randomUUID().toString()

// 连接复用：开启 JDK keep-alive 并提高缓存上限，减少高频请求导致的临时端口(TIME_WAIT)耗尽
if (System.getProperty("http.maxConnections") == null) {
    System.setProperty("http.keepAlive", "true")
    System.setProperty("http.maxConnections", "2000")
}

String body = '{"sessionId":"' + sessionId + '","question":"' + question + '"}'

// ============================================================
// SSE 并发模型说明：
// SSE 响应是服务器单向推送，一轮对话读完 END 后连接即被服务端收尾，
// 无法在同一连接上连续发起多次 POST 流式请求。因此 scenario3 的核心
// 度量是「并发长连接容量」：每线程 = 一条活跃对话连接，进程持有的
// 端口数 ≈ 并发线程数而非 请求数×轮次，从而避免 Windows 临时端口耗尽。
// 因此请用小并发 × 小 LOOPS 压测（见 run-perf 注释）。
//
// 注意：使用 JSR223 隐式 SampleResult 变量直接读写当前采样器，
// 若自行 new SampleResult 并 return，label/responseMessage 会被
// wrapper 采样器覆盖，ttft 等自定义字段无法写入 CSV。
// ============================================================

SampleResult.sampleStart()
long s0 = System.currentTimeMillis()

URL u = new URL(proto + "://" + host + ":" + port + "/chat")
HttpURLConnection conn = (HttpURLConnection) u.openConnection()
conn.setRequestMethod("POST")
conn.setConnectTimeout(5000)
conn.setReadTimeout(15000)
conn.setDoOutput(true)
conn.setDoInput(true)
conn.setRequestProperty("Content-Type", "application/json;charset=UTF-8")
conn.setRequestProperty("Accept", "text/event-stream")
conn.setRequestProperty("user-info", String.valueOf(userNum))
BufferedOutputStream out = new BufferedOutputStream(conn.getOutputStream())
out.write(body.getBytes("UTF-8")); out.flush(); out.close()

int code = conn.getResponseCode()
InputStream is = (code >= 200 && code < 300) ? conn.getInputStream() : conn.getErrorStream()
BufferedReader br = new BufferedReader(new InputStreamReader(is, "UTF-8"))

long ttft = 0
boolean ttftSet = false
boolean ended = false
StringBuilder sb = new StringBuilder()
String line
try {
    while ((line = br.readLine()) != null) {
        if (line.startsWith("data:")) {
            if (!ttftSet) { ttft = System.currentTimeMillis() - s0; ttftSet = true }
            sb.append(line.substring(5)).append('\n')
            if (line.indexOf('"type":"END"') >= 0) { ended = true; break }
        }
    }
} finally {
    // 读满响应体即关闭缓冲流，交由连接自然收尾；不调用 conn.disconnect()
    // （SSE 长连接场景 disconnect 会主动断开并留 TIME_WAIT，放大端口压力）
    try { br.close() } catch (IOException ignore) {}
    try { is.close() } catch (IOException ignore) {}
}
long total = System.currentTimeMillis() - s0
SampleResult.sampleEnd()

SampleResult.setSuccessful(ended && code >= 200 && code < 300)
SampleResult.setResponseCode(String.valueOf(code))
SampleResult.setResponseMessage((ended ? "SSE END ok" : "no END") + " total=" + total + "ms ttft=" + (ttftSet ? ttft : total) + "ms")
SampleResult.setResponseData(sb.toString().getBytes("UTF-8"))]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="interpreterClass"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
