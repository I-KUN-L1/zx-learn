<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhixing</groupId>
        <artifactId>zx-learn</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>zx-common</artifactId>
    <name>zx-common</name>
    <description>公共基础模块：统一响应、异常、工具类、自动配置</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- RocketMQ 客户端（通用生产者/序列化封装，秒杀等异步链路复用；版本与 zx-trade 保持一致） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <version>4.9.7</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          spring-tx：org.springframework.dao.DataIntegrityViolationException 所在模块。
          CommonExceptionAdvice 用它把「数据完整性约束失败（必填项缺失 / 唯一键冲突 / 字段超长）」
          映射为 400 明确提示，而不是落到兜底的 500「系统繁忙，请稍后再试」。

          ⚠ 必须显式声明且**不能 optional**：
            zx-media / zx-message 等无数据库的服务本身只经由 mybatis-plus（optional）
            间接看到该类型，运行期类路径上并没有 spring-tx —— 一旦缺失，Spring 在
            introspect CommonExceptionAdvice 时会抛
            NoClassDefFoundError: org/springframework/dao/DataIntegrityViolationException，
            导致这两个服务**启动直接失败**（已踩过一次）。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
    </dependencies>
</project>
