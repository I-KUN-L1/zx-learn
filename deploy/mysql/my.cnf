# ============================================================
# 知行智学（zx-learn）MySQL 8 部署配置
# 由 docker-compose 挂载覆盖 /etc/mysql/conf.d/my.cnf
# 该目录下所有 *.cnf 会被 mysqld 启动时自动加载
# ============================================================

[mysqld]
# 字符集
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# 时区（应用统一使用 Asia/Shanghai）
default-time-zone=+08:00

# 连接与线程
max_connections=500
max_connect_errors=1000
wait_timeout=3600
interactive_timeout=3600

# 隔离级别（下单/本地消息表典型场景，读已提交可规避间隙锁死锁）
transaction-isolation=READ-COMMITTED

# InnoDB 缓冲与并发（本地开发建议值，可按机器内存调整）
innodb_buffer_pool_size=512M
innodb_log_file_size=128M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT
innodb_io_capacity=1000

# SQL 模式（MySQL 8 默认的严格模式，避免静默截断）
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# 慢查询日志
slow_query_log=1
slow_query_log_file=/var/lib/mysql/zx-learn-slow.log
long_query_time=2

[client]
default-character-set=utf8mb4